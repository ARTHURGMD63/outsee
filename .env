# Valeurs par défaut, valables pour l'environnement Docker (compose.yaml).
# Les surcharges locales vont dans .env.local, jamais versionné.
# Aucun secret de production ici : en production, tout passe par de vraies variables d'environnement.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://outsee:outsee@db:3306/outsee?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> doctrine/mongodb-odm-bundle ###
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=outsee
###< doctrine/mongodb-odm-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM="Outsee <contact@outsee.fr>"
###< symfony/mailer ###
