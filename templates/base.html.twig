<!DOCTYPE html>
{# « univers » : la nuit pour les étudiants (thème au choix), le jour pour les pros (toujours clair). #}
{% set univers = univers|default('etudiant') %}
{% set theme = univers == 'pro' ? 'light' : (app.user ? app.user.theme.value : 'dark') %}
<html lang="fr" data-theme="{{ theme }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Outsee{% endblock %} · Outsee</title>
        <meta name="description" content="{% block description %}Les meilleures sorties étudiantes de Clermont-Ferrand, avec des réductions réservées aux membres.{% endblock %}">
        <meta name="theme-color" content="{{ theme == 'dark' ? '#111013' : '#F5F1E8' }}">
        <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
        <link rel="preload" href="{{ asset('fonts/unbounded-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/instrument-sans-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="sr-only" href="#main-content">Aller au contenu</a>

        {% block body %}
            <div class="app-shell">
                {% block entete %}{% endblock %}

                <main id="main-content" class="page-content">
                    {{ include('partials/_messages.html.twig') }}
                    {% block contenu %}{% endblock %}
                </main>
            </div>

            {% block navigation %}
                {% if is_granted('ROLE_ETUDIANT') %}
                    {{ include('partials/_navigation.html.twig') }}
                {% endif %}
            {% endblock %}
        {% endblock %}
    </body>
</html>
