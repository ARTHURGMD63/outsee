{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    <main id="main-content" class="auth-page">
        <div class="auth-logo">{{ include('partials/_marque.html.twig', {lien: path('accueil')}) }}</div>

        <h1 class="auth-headline titre-page">
            <span class="display" style="font-size:var(--fs-8);">Nouveau</span>
            <span class="display-italic" style="font-size:var(--fs-8);">mot de passe.</span>
        </h1>

        {{ form_start(formulaire) }}
            {{ form_row(formulaire.motDePasse.first) }}
            {{ form_row(formulaire.motDePasse.second) }}
            <button type="submit" class="btn btn-primary btn-full">Enregistrer</button>
        {{ form_end(formulaire) }}
    </main>
{% endblock %}
