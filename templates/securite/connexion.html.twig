{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main id="main-content" class="auth-page">
        <div class="auth-logo">{{ include('partials/_marque.html.twig', {lien: path('accueil')}) }}</div>

        <h1 class="auth-headline titre-page">
            <span class="display" style="font-size:var(--fs-9);">Content de te</span>
            <span class="display-italic" style="font-size:var(--fs-9);">revoir.</span>
        </h1>

        {{ include('partials/_messages.html.twig') }}

        {% if erreur %}
            <div class="form-error" role="alert">{{ erreur.messageKey|trans(erreur.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('connexion') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" value="{{ dernier_email }}" autocomplete="username" required autofocus>
            </div>
            <div class="form-group">
                <label for="mot_de_passe">Mot de passe</label>
                <input type="password" id="mot_de_passe" name="mot_de_passe" autocomplete="current-password" required>
            </div>

            <div class="auth-oubli">
                <label class="case"><input type="checkbox" name="_remember_me"> Rester connecté</label>
                <a href="{{ path('mot_de_passe_oublie') }}">Mot de passe oublié ?</a>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Se connecter</button>
        </form>

        <p class="auth-link">Pas encore de compte ? <a href="{{ path('inscription') }}">Créer un compte</a></p>
    </main>
{% endblock %}
