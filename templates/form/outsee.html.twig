{# Thème des formulaires : reprend les classes de la charte (.form-group, .aide-champ, .interest-chip). #}
{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div class="form-group{{ errors|length ? ' form-group--erreur' }}">
        {{- form_label(form) -}}
        {{- form_widget(form, {attr: errors|length ? {'aria-invalid': 'true'} : {}}) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="aide-champ">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- if compound and form.parent is null -%}
            {%- for error in errors -%}
                <div class="form-error" role="alert">{{ error.message }}</div>
            {%- endfor -%}
        {%- else -%}
            {%- for error in errors -%}
                <p class="champ-erreur">{{ error.message }}</p>
            {%- endfor -%}
        {%- endif -%}
    {%- endif -%}
{%- endblock form_errors -%}

{# Cases à cocher multiples : des pastilles cliquables, comme sur l'ancien site. #}
{%- block choice_widget_expanded -%}
    {%- if multiple -%}
        <div {{ block('widget_container_attributes') }} class="interets-liste">
            {%- for child in form -%}
                <label class="interest-chip">
                    {{- form_widget(child) -}}
                    <span class="interest-tag">{{ child.vars.label }}</span>
                </label>
            {%- endfor -%}
        </div>
    {%- else -%}
        <div {{ block('widget_container_attributes') }} class="type-toggle">
            {%- for child in form -%}
                <label class="type-toggle-btn{{ child.vars.checked ? ' active' }}">
                    {{- form_widget(child) -}}
                    <span>{{ child.vars.label }}</span>
                </label>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock choice_widget_expanded -%}

{%- block checkbox_row -%}
    <div class="form-group">
        <label class="case">
            {{- form_widget(form) -}}
            <span>{{ label is not same as(false) ? label : '' }}</span>
        </label>
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}
