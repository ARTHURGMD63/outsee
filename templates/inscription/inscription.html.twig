{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <main id="main-content" class="auth-page">
        <div class="auth-logo">{{ include('partials/_marque.html.twig', {lien: path('accueil')}) }}</div>

        <h1 class="auth-headline titre-page">
            <span class="display" style="font-size:var(--fs-8);">Rejoins la</span>
            <span class="display-italic" style="font-size:var(--fs-8);">communauté.</span>
        </h1>

        {{ form_start(formulaire, {attr: {'data-controller': 'inscription', novalidate: 'novalidate'}}) }}
            {{ form_errors(formulaire) }}

            <div data-action="change->inscription#basculer">
                {{ form_row(formulaire.type, {label: false}) }}
            </div>

            <div class="form-row">
                {{ form_row(formulaire.prenom) }}
                {{ form_row(formulaire.nom) }}
            </div>
            {{ form_row(formulaire.email) }}
            {{ form_row(formulaire.motDePasse) }}
            {{ form_row(formulaire.dateNaissance) }}

            <div data-inscription-target="etudiant">
                {{ form_row(formulaire.ville) }}
                <div class="form-row">
                    {{ form_row(formulaire.ecole) }}
                    {{ form_row(formulaire.promo) }}
                </div>
                {{ form_row(formulaire.interets) }}
            </div>

            <div data-inscription-target="partenaire">
                {{ form_row(formulaire.nomEtablissement) }}
                {{ form_row(formulaire.typeEtablissement) }}
            </div>

            {{ form_row(formulaire.cgu, {label: 'J\'accepte les conditions générales d\'utilisation et la politique de confidentialité.'}) }}

            <button type="submit" class="btn btn-primary btn-full">Créer mon compte</button>
        {{ form_end(formulaire) }}

        <p class="auth-link">Déjà un compte ? <a href="{{ path('connexion') }}">Se connecter</a></p>
    </main>
{% endblock %}
