{# Logo : deux anneaux entrelacés et « outsee ». Le nom lisible reste « Outsee » pour les lecteurs d'écran. #}
{% set suffixe = suffixe|default('') %}
{% set contenu %}
    <span class="sr-only">Outsee{{ suffixe ? ' ' ~ suffixe }}</span>
    <svg class="marque__anneaux" viewBox="0 0 52 32" fill="none" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="12.5" stroke="var(--rouge)" stroke-width="5"/>
        <circle cx="36" cy="16" r="12.5" stroke="var(--noir)" stroke-width="5"/>
        <path d="M 28.45 14.91 A 12.5 12.5 0 0 1 24.03 25.58" stroke="var(--rouge)" stroke-width="5"/>
    </svg>
    <span class="marque__mot" aria-hidden="true">outs<span class="marque__ee">ee</span></span>
    {% if suffixe %}<span class="marque__suffixe" aria-hidden="true">{{ suffixe }}</span>{% endif %}
{% endset %}
{% if lien is defined and lien %}
    <a class="marque" href="{{ lien }}">{{ contenu }}</a>
{% else %}
    <span class="marque">{{ contenu }}</span>
{% endif %}
